{
  "name": "sanad-browser-desktop",
  "version": "1.3.4",
  "description": "Sanad Al-Haramain desktop browser powered by Chromium through Electron",
  "main": "main.cjs",
  "author": "Murad Aljohani",
  "homepage": "https://ip-murad.com/browser",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/policy.test.cjs tests/updates.test.cjs tests/security.test.cjs tests/protection.test.cjs tests/store-package.test.cjs tests/bounded-file.test.cjs tests/performance.test.cjs tests/youtube-data.test.cjs tests/youtube-injection.test.cjs tests/state-encryption.test.cjs tests/packaging-globs.test.cjs",
    "prepare:filters": "node scripts/prepare-filters.cjs",
    "test:desktop": "node tests/desktop.test.cjs && node tests/tabs.test.cjs && node tests/protection-desktop.test.cjs",
    "pack": "npm run prepare:filters && electron-builder --dir --publish never",
    "dist:win": "npm run prepare:filters && electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "npm run prepare:filters && electron-builder --linux AppImage --x64 --publish never",
    "dist:store": "npm run prepare:filters && electron-builder --config electron-builder.store.cjs --win appx --x64 --publish never",
    "test:youtube:live": "node tests/youtube-live.test.cjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-electron": "2.20.1",
    "@mozilla/readability": "0.6.0",
    "tldts-experimental": "7.4.10"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "@electron/fuses": "2.0.0",
    "electron-builder": "26.17.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.ip-murad.sanad.browser",
    "productName": "Sanad Browser",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "updates.cjs",
      "page-actions.cjs",
      "preload.cjs",
      "policy.cjs",
      "store.cjs",
      "state-encryption.cjs",
      "protection.cjs",
      "filter-lists.cjs",
      "youtube-guard.cjs",
      "security.cjs",
      "ui/**",
      "assets/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "store-distribution.cjs",
      "bounded-file.cjs",
      "style-cache.cjs",
      "youtube-data.cjs",
      "youtube-injection.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/mark.png",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "perMachine": false,
      "allowElevation": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Sanad-Browser-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Sanad-Browser-${version}-${arch}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/mark.png",
      "category": "Network",
      "artifactName": "Sanad-Browser-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "minimatch": "https://raw.githubusercontent.com/muradaljohani/Sanad-Browser/db3ebed0297ab5502e8e19c65af9a6494d6fe8e6/desktop/vendor/sanad-minimatch-compat-1.0.1.tgz"
  }
}
